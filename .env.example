# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RapidAPI Shopping API credentials for Gadget Deal Tracker
RAPIDAPI_KEY=your_rapidapi_application_key_here
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# Host strings for different RapidAPI services. Note: RAPIDAPI_KEY is reused across all of them.
GOOGLE_SHOPPING_API_HOST=real-time-product-search.p.rapidapi.com
FLIPKART_API_HOST=flipkart-apis.p.rapidapi.com

# PostgreSQL Connection Settings
# Primary: Supply full consolidated connection string (Recommended for Render, Neon, Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/deal_tracker

# Secondary: Individual connection parameters (Used if DATABASE_URL is not supplied)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_DATABASE=deal_tracker

# Session & Security Settings
JWT_SECRET=your_jwt_signing_token_key_change_me_in_production
NODE_ENV=development
PORT=3000

# Budget & Quota Conservation Settings
# The day of the month your RapidAPI subscription billing cycles renew (e.g. 15 if it renews on 15th)
BILLING_CYCLE_START_DAY=1

# Monthly caps (with built-in buffers) to avoid exceeding hard RapidAPI plan limits
AMAZON_MONTHLY_CAP=85
GOOGLE_SHOPPING_MONTHLY_CAP=85
FLIPKART_MONTHLY_CAP=5

# Pricing cache TTL in days (30 days recommended to minimize API call rates)
CACHE_TTL_DAYS=30

# Email Provider Settings (e.g., Resend, SendGrid, SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Gadget Tracker" <alerts@gadgettracker.com>
