# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RapidAPI Shopping API credentials for Gadget Deal Tracker
RAPIDAPI_KEY=your_rapidapi_application_key_here
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# PostgreSQL Connection Settings
# Primary: Supply full consolidated connection string (Recommended for Render, Neon, Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/deal_tracker

# Secondary: Individual connection parameters (Used if DATABASE_URL is not supplied)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_DATABASE=deal_tracker

# Session & Security Settings
JWT_SECRET=your_jwt_signing_token_key_change_me_in_production
NODE_ENV=development
PORT=3000
