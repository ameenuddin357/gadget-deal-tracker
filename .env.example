# ==========================================
# GADGET TRACKER PRO - ENVIRONMENT VARIABLES
# ==========================================

# Gemini AI API
# Required for AI-powered features.
GEMINI_API_KEY=your_gemini_api_key_here

# Application URL
# Local development: http://localhost:3000
# Production: Your deployed application URL.
APP_URL=http://localhost:3000

# ==========================================
# RAPIDAPI CONFIGURATION
# ==========================================

RAPIDAPI_KEY=your_rapidapi_application_key_here
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

GOOGLE_SHOPPING_API_HOST=real-time-product-search.p.rapidapi.com
FLIPKART_API_HOST=flipkart-apis.p.rapidapi.com

# ==========================================
# POSTGRESQL DATABASE
# ==========================================

# Primary database connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/deal_tracker

# SSL configuration
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection pool size (1-20)
DB_POOL_MAX=10

# Alternative individual database settings.
# Used only when DATABASE_URL is not supplied.
SQL_HOST=localhost
DB_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_secure_password
SQL_DB_NAME=deal_tracker

# ==========================================
# AUTHENTICATION AND SECURITY
# ==========================================

JWT_SECRET=replace_with_a_long_random_secret

# Email verification intentionally disabled.
EMAIL_VERIFICATION_ENABLED=false

# Required only if email verification is enabled.
EMAIL_VERIFICATION_SECRET=replace_with_a_separate_long_random_secret

# ==========================================
# SERVER CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=3000

# 0 = Local development
# 1 = Single trusted reverse proxy (configure according to hosting).
TRUST_PROXY_HOPS=0

# ==========================================
# RAPIDAPI USAGE LIMITS
# ==========================================

BILLING_CYCLE_START_DAY=1

AMAZON_MONTHLY_CAP=85
GOOGLE_SHOPPING_MONTHLY_CAP=85
FLIPKART_MONTHLY_CAP=5

# Pricing cache duration in days.
CACHE_TTL_DAYS=30

# ==========================================
# OPTIONAL EMAIL PROVIDER CONFIGURATION
# ==========================================

# Configure only if email functionality is enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Gadget Tracker" <alerts@example.com>